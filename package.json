{
  "name": "shenanyrinth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 2–6 Player, turn-based RPG board game played in the browser.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "sh scripts/start.sh",
    "build": "vite build",
    "serve": "node src/server/main.ts",
    "dev": "node scripts/dev.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "react-doctor . -y --scope full --blocking warning --no-score --no-supply-chain",
    "prepare": "husky"
  },
  "dependencies": {
    "express": "^5.3.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react-doctor": "^0.9.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
